{
  "name": "antigravity-phone-mockup",
  "version": "1.4.0",
  "description": "Self-contained interactive smartphone mockup simulating Antigravity Flutter Mobile App",
  "main": "dist/phone-mockup.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --minify --format=iife --global-name=AntigravityPhoneMockupBundle --outfile=dist/phone-mockup.js",
    "dev": "esbuild src/index.ts --bundle --watch --outfile=dist/phone-mockup.js"
  },
  "keywords": ["antigravity", "mockup", "flutter", "simulator"],
  "author": "Nilson",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
